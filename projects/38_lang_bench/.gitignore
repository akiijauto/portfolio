# 計測結果は実行環境ごとに変わる生成物。リポジトリには置かない。
# 共有したい結果は results/<timestamp>/report.html を個別に取り出すこと。
results/*
!results/.gitkeep

# 各言語のビルド成果物・依存関係。すべて Dockerfile / Makefile から再生成できる。
services/node/node_modules/
services/node/dist/
services/java/target/
services/csharp/**/bin/
services/csharp/**/obj/
services/php/vendor/
services/rust/target/

# ── Notion ──────────────────────────────
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PORTFOLIO_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini AI ──────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini

# ── Tavily Search (競合調査ツールの検索) ──
# https://tavily.com で無料登録（カード不要・月1,000件まで無料）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twitter / X ──────────────────────────
TWITTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_ACCESS_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Discord ──────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxx/xxxxxxx

# ── Flask (省略時はランダム生成) ─────────
SECRET_KEY=your-secret-key-here
